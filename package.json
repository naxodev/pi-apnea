{
  "name": "@naxodev/apnea",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-role Pi + Herdr workflow: file-backed handoffs, no hidden subagents",
  "license": "MIT",
  "type": "module",
  "bin": { "apnea": "./dist/cli.js" },
  "scripts": {
    "build": "bun build ./extension/cli/main.ts --target=bun --outfile ./dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": ["pi-package", "pi", "herdr", "apnea", "workflow"],
  "pi": {
    "skills": ["./skills"],
    "prompts": ["./prompts"],
    "extensions": ["./extension"]
  },
  "files": [
    "CONTEXT.md",
    "README.md",
    "briefs",
    "docs",
    "schemas",
    "skills",
    "prompts",
    "examples",
    "extension",
    "herdr-plugin",
    "dist"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@types/node": "^26.1.1",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "effect": "4.0.0-beta.101",
    "typebox": "^1.3.6"
  }
}
