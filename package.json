{
  "name": "@naxodev/apnea",
  "version": "0.1.0",
  "description": "Multi-role Pi + Herdr workflow: file-backed handoffs, no hidden subagents",
  "license": "MIT",
  "author": "Nacho Vazquez",
  "homepage": "https://github.com/naxodev/pi-apnea#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naxodev/pi-apnea.git"
  },
  "bugs": {
    "url": "https://github.com/naxodev/pi-apnea/issues"
  },
  "type": "module",
  "bin": {
    "apnea": "./dist/cli.js"
  },
  "engines": {
    "bun": ">=1.3.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./extension/cli/main.ts --target=bun --outfile ./dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "bun run build"
  },
  "keywords": [
    "pi-package",
    "pi",
    "herdr",
    "apnea",
    "workflow"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "extensions": [
      "./extension"
    ]
  },
  "files": [
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CONTEXT.md",
    "README.md",
    "briefs",
    "docs/protocol",
    "docs/adr",
    "schemas",
    "skills",
    "prompts",
    "extension",
    "!extension/**/*.test.ts",
    "!extension/test",
    "herdr-plugin",
    "dist"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@types/node": "^26.1.1",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "effect": "4.0.0-beta.101",
    "typebox": "^1.3.6"
  }
}
